{
	"name": "claude-code-browser-annotator",
	"displayName": "Claude Code Browser Annotator",
	"description": "A VS Code-native browser experience for commenting on pages and sending the context to Claude Code.",
	"version": "1.0.9",
	"publisher": "drgoldenpants",
	"icon": "media/icons/claude-code-browser.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/GibsonHu/ClaudeBrowser.git"
	},
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other",
		"Visualization"
	],
	"files": [
		"src/**",
		"docs/**",
		"media/**",
		"node_modules/playwright-core/**",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"browser",
		"claude",
		"claude code",
		"annotation",
		"playwright"
	],
	"activationEvents": [
		"onCommand:claude-code-browser-annotator.open"
	],
	"main": "./src/extension.js",
	"extensionKind": [
		"workspace",
		"ui"
	],
	"contributes": {
		"commands": [
			{
				"command": "claude-code-browser-annotator.open",
				"title": "Claude Code Browser Annotator",
				"category": "Browser",
				"icon": "media/icons/claude-code-browser.png"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "claude-code-browser-annotator.open"
				}
			],
			"editor/title": [
				{
					"command": "claude-code-browser-annotator.open",
					"group": "navigation@100"
				}
			]
		},
		"configuration": {
			"title": "Claude Code Browser Annotator",
			"properties": {
				"claude-code-browser-annotator.homepage": {
					"type": "string",
					"default": "http://localhost:3000",
					"description": "Home suggestion shown when the browser has no recent pages."
				},
				"claude-code-browser-annotator.refreshInterval": {
					"type": "number",
					"default": 1000,
					"minimum": 500,
					"maximum": 5000,
					"description": "Milliseconds between background visual change checks. Browser interactions still refresh immediately."
				},
				"claude-code-browser-annotator.renderScale": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 4,
					"description": "Browser pixel density. 0 automatically matches the VS Code display; use 1–4 to override it."
				},
				"claude-code-browser-annotator.chromeExecutable": {
					"type": "string",
					"default": "",
					"description": "Optional Chrome/Chromium executable. Common system paths are detected automatically."
				},
				"claude-code-browser-annotator.ignoreHttpsErrors": {
					"type": "boolean",
					"default": true,
					"description": "Allow local development servers with self-signed certificates."
				}
			}
		}
	},
	"scripts": {
		"check": "node --check src/extension.js && node --check media/browser.js",
		"test": "node --test test/*.test.js",
		"package": "npx @vscode/vsce package"
	},
	"dependencies": {
		"playwright-core": "^1.55.0"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.6.0"
	},
	"__metadata": {
		"installedTimestamp": 1788740817689,
		"targetPlatform": "undefined",
		"size": 8076784
	}
}
